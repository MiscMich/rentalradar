# Demo mode is deterministic and requires no credentials.
DEMO_MODE=true
PROVIDERS=openai,anthropic,gemini,perplexity

# Optional server-only HTTP adapters. These are ignored in demo mode.
# Use non-secret placeholders in this file and keep real values in .env.local.
OPENAI_BASE_URL=https://provider.invalid/openai
OPENAI_API_KEY=replace-with-server-only-key
OPENAI_MODEL=replace-with-model-name

ANTHROPIC_BASE_URL=https://provider.invalid/anthropic
ANTHROPIC_API_KEY=replace-with-server-only-key
ANTHROPIC_MODEL=replace-with-model-name

GEMINI_BASE_URL=https://provider.invalid/gemini
GEMINI_API_KEY=replace-with-server-only-key
GEMINI_MODEL=replace-with-model-name

PERPLEXITY_BASE_URL=https://provider.invalid/perplexity
PERPLEXITY_API_KEY=replace-with-server-only-key
PERPLEXITY_MODEL=replace-with-model-name
